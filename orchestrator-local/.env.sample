# DigitalOcean Spaces (S3-compatible) -- durable outbox for Runner -> Orchestrator
# job-completion results, replacing the direct HTTP callback (see docs/ for why:
# it needs to tolerate the Orchestrator being offline for arbitrary stretches).
#
# Create the key via: doctl spaces keys create mflux-runpod-outbox --output json
# Create the bucket via: aws --endpoint-url $DO_SPACES_ENDPOINT s3api create-bucket --bucket <name>
# (see the `spaces` skill for full setup)

# Access key id (from `doctl spaces keys create`)
DO_SPACES_KEY=xxx

# Secret access key (shown once at creation -- from the same `doctl spaces keys create` output)
DO_SPACES_SECRET=xxx

# Region slug the bucket lives in, e.g. syd1, nyc3, sfo3, ams3, fra1, sgp1 -- pick
# whichever is geographically closest/cheapest for you; RunPod DC doesn't need to match
DO_SPACES_REGION=nyc3

# Full endpoint URL for that region, e.g. https://syd1.digitaloceanspaces.com
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Bucket name
DO_SPACES_BUCKET=xxx

# --- Orchestrator core (fill in) ---
HF_TOKEN=

# HF_ORG=mflux-community   # optional, this is the default

# --- Only needed for POST /generate with dispatch:true ---
RUNPOD_API_KEY=
RUNNER_ENDPOINT_ID=jx45e9ewmop06z
