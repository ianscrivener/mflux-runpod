__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

HF_CACHE

# Generated at runtime, not source
data/reports.sqlite
data/models_hf.json
.flash/

# NOT excluded from git (already tracked -- this entry only stops Flash's
# `flash deploy` from scanning these as candidate @Endpoint modules, since
# Flash reads .gitignore as its own ignore-pattern source; see
# runpod_flash's ignore.py::load_ignore_patterns). These are plain Docker
# entrypoints (dockerFiles/*_handler.py), not Flash resources -- Flash's
# static import scan fails on them (e.g. huggingface_hub unresolved
# locally) and previously aborted every `flash deploy` in the project until
# excluded, same issue as the old mflux-save.py.
dockerFiles/

# Same reasoning as dockerFiles/ above: Flash's resource scanner walks
# EVERY .py file under project_dir (rglob("*.py")), regardless of which
# directory it's in -- moving app/runner_endpoint.py here does NOT stop
# `flash deploy` from finding and redeploying its @Endpoint definitions
# unless this directory is also excluded via .gitignore (confirmed live,
# 2026-08-18: mflux-runner/mflux-runner-health came back after the move,
# before this entry was added).
_deprecated/
