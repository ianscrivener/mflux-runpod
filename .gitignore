# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets -- never committed
.env

HF_CACHE

# Generated at runtime, not source
data/mflux-models.sqlite
data/.hf_sync_state.json
# The seven HF-bucket-synced datasets (see hf_datasets.yaml) -- all
# regenerable via `pull()`/the app's own refresh triggers, no need for git
# history on top of what the HF bucket already keeps.
data-hf-sync/
.flash/

# NOT excluded from git (already tracked -- this entry only stops Flash's
# `flash deploy` from scanning these as candidate @Endpoint modules, since
# Flash reads .gitignore as its own ignore-pattern source; see
# runpod_flash's ignore.py::load_ignore_patterns). These are plain Docker
# entrypoints (dockerFiles/*_handler.py), not Flash resources -- Flash's
# static import scan fails on them (e.g. huggingface_hub unresolved
# locally) and previously aborted every `flash deploy` in the project until
# excluded, same issue as the old mflux-save.py.
dockerFiles/

# Same reasoning as dockerFiles/ above: Flash's resource scanner walks
# EVERY .py file under project_dir (rglob("*.py")), regardless of which
# directory it's in -- moving app/runner_endpoint.py here does NOT stop
# `flash deploy` from finding and redeploying its @Endpoint definitions
# unless this directory is also excluded via .gitignore (confirmed live,
# 2026-08-18: mflux-runner/mflux-runner-health came back after the move,
# before this entry was added).
_deprecated/
z_*.*

# Same reasoning again: scripts/sync_runner_orchestrator_url.py and
# scripts/test_api.py both do `from resolve_orchestrator_url import ...` --
# a bare same-directory import that only resolves when the script is run
# directly (Python adds its own dir to sys.path in __main__ mode). Flash's
# scanner imports each .py file in isolation, not as __main__, so that
# import fails there. Confirmed live, 2026-08-18: this took mflux-orchestrator
# down (clean-slate deleted the old one, `flash deploy` then failed outright
# on ModuleNotFoundError: No module named 'resolve_orchestrator_url' trying
# to recreate it) -- not just a warning like app/runner.py's dynamic-import
# notice, a hard deploy failure. None of these are Flash resources anyway.
scripts/
zz_generate.sh
zz_scratch.txt

# Admin web app (webapp/, Svelte + Vite) -- node_modules and the built
# static bundle are both regenerable (`cd webapp && npm install && npm run
# build`), not source. Built output lands in app/static/, served by
# app/main.py's StaticFiles mount.
webapp/node_modules/
app/static/
.DS_Store
